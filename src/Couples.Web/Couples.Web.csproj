<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Couples.Application\Couples.Application.csproj" />
    <ProjectReference Include="..\Couples.Infrastructure\Couples.Infrastructure.csproj" />
    <ProjectReference Include="..\Couples.AI\Couples.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.Apple" Version="10.1.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.14" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="4.8.0" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- dotnet user-secrets for local provider keys (docs/operations/external-sign-in.md). -->
    <UserSecretsId>bridgetogether-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- One source for the legal texts: reviewed as Markdown in docs/legal, shown in the app. -->
    <EmbeddedResource Include="..\..\docs\legal\privacy-notice.md" LogicalName="legal/privacy-notice.md" />
    <EmbeddedResource Include="..\..\docs\legal\pilot-terms.md" LogicalName="legal/pilot-terms.md" />
  </ItemGroup>

</Project>
