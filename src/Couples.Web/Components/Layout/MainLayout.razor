@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="AppTheme.Theme" />

@* Interactive pages render without prerendering, so their own <PageTitle> can't reach the
   statically rendered head. This gives every route a title (WCAG 2.4.2); static pages still
   override it with their own. *@
<PageTitle>@RouteTitles.For(NavigationManager.ToBaseRelativePath(NavigationManager.Uri))</PageTitle>

<a class="skip-link" href="@SkipHref" data-skip-link>Skip to main content</a>

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6" Class="ml-2">BridgeTogether</MudLink>
        <MudSpacer />
        <QuickExit />
        <AuthorizeView>
            <Authorized>
                <MudLink Href="workspace" Color="Color.Inherit" Class="mx-1 mx-sm-2">Workspace</MudLink>
                <MessagesNavLink />
                <MudLink Href="intake" Color="Color.Inherit" Class="mx-1 mx-sm-2">My topics</MudLink>
                <MudLink Href="exercises" Color="Color.Inherit" Class="mx-1 mx-sm-2">Exercises</MudLink>
                <AuthorizeView Roles="@Couples.Web.Administration.AdminBootstrap.AdminRole" Context="admin">
                    <MudLink Href="admin/exercises" Color="Color.Inherit" Class="mx-1 mx-sm-2">Admin</MudLink>
                </AuthorizeView>
                <MudLink Href="support" Color="Color.Inherit" Class="mx-1 mx-sm-2">Support</MudLink>
                <MudLink Href="Account/Manage" Color="Color.Inherit" Class="mx-1 mx-sm-2">Account</MudLink>
                <form action="Account/Logout" method="post" class="d-inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="" />
                    <button type="submit" class="appbar-link mx-1 mx-sm-2">Log out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudLink Href="support" Color="Color.Inherit" Class="mx-1 mx-sm-2">Support</MudLink>
                <MudLink Href="Account/Login" Color="Color.Inherit" Class="mx-1 mx-sm-2">Log in</MudLink>
                <MudLink Href="Account/Register" Color="Color.Inherit" Class="mx-1 mx-sm-2">Create account</MudLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <main id="main-content" tabindex="-1">
            <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
                @Body
            </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // The page has <base href="/">, so a bare "#main-content" would point at the home page.
    private string SkipHref => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('#')[0] + "#main-content";
}
