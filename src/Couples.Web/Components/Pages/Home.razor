@page "/"

<PageTitle>BridgeTogether</PageTitle>

<MudStack Spacing="4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Talk through hard things, at your own pace.</MudText>

    <MudText Typo="Typo.body1">
        BridgeTogether helps partners reflect privately, find words for feelings and needs,
        and share only the messages they choose to share.
    </MudText>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2">Private by default</MudText>
        <MudText Typo="Typo.body2">
            What you write in a reflection stays yours. Nothing is sent to your partner unless
            you review it and approve it.
        </MudText>
    </MudPaper>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        BridgeTogether is an educational communication-support tool. It is not therapy,
        diagnosis, or a crisis service, and it does not replace a licensed professional.
        If you are in danger, contact your local emergency number.
    </MudAlert>

    <MudText Typo="Typo.caption">Early development preview. Accounts are not available yet.</MudText>
</MudStack>
