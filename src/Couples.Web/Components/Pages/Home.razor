@page "/"

<PageTitle>BridgeTogether</PageTitle>

<MudStack Spacing="4">
    <div class="home-hero">
        <div class="home-hero-text">
            <MudText Typo="Typo.h4" HtmlTag="h1">Talk through hard things, at your own pace.</MudText>

            <MudText Typo="Typo.body1">
                BridgeTogether helps partners reflect privately, find words for feelings and needs,
                and share only the messages they choose to share.
            </MudText>
        </div>

        <figure class="home-hero-art">
            <img src="images/couples-hero.svg" width="640" height="600"
                 alt="Six couples standing together: an older Black couple, two women, a woman in a hijab with her partner, a man using a wheelchair with his partner, two men, and a plus-size couple." />
        </figure>
    </div>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2">Private by default</MudText>
        <MudText Typo="Typo.body2">
            What you write in a reflection stays yours. Nothing is sent to your partner unless
            you review it and approve it.
        </MudText>
    </MudPaper>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        BridgeTogether is an educational communication-support tool. It is not therapy,
        diagnosis, or a crisis service, and it does not replace a licensed professional.
        If you are in danger, contact your local emergency number.
    </MudAlert>

    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="workspace">Go to your workspace</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="Account/Register">Create an account</MudButton>
            </NotAuthorized>
        </AuthorizeView>
        <MudButton Variant="Variant.Text" Href="privacy">How your privacy works</MudButton>
    </MudStack>

    <ExpertPerspectives />

    <MudText Typo="Typo.caption">Early development preview.</MudText>
</MudStack>
