@inherits LayoutComponentBase

@* In a BlazorWebView everything is interactive, so the MudBlazor providers can live in the layout
   (the web app renders them per page because its layout is static). *@
<MudThemeProvider Theme="AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudText Typo="Typo.h6" HtmlTag="span">BridgeTogether</MudText>
    </MudAppBar>
    <MudMainContent Class="pt-14">
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
            <main id="main-content">@Body</main>
        </MudContainer>
    </MudMainContent>
</MudLayout>
